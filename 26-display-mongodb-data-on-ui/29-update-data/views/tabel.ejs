<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>
    <table>
        <tr>
            <th>name</th>
            <th>age</th>
            <th>email</th>
            <th>operation</th>
        </tr>
        <% result.forEach((student)=>{%>
            <tr>
                <td><%=student.name%></td>
                <td><%=student.age%></td>
                <td><%=student.email%></td>
                <td><a href="">delete</a></td>
                <td><a href="/ui/student/<%=student._id%>">update</a></td>
            </tr>
            <% })%>

    </table>

</body>

</html>