<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
   <h1>data will be there</h1>
    <table>
        <tr>
            <th>name</th>
            <th>age</th>
            <th>email</th>
        </tr>
        <%students.forEach(student=>{%>
              <tr>
            <td><%=student.name%></td>
            <td><%=student.age%></td>
            <td><%=student.email%></td>
        </tr>
       <% }) %>
       
    </table>
    
</body>
</html>