<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <%- include('navbar')%>
        <div class="container">
            <h1>Todo List</h1>

            <form action="/multi-delete" method="post">

                <button class="delete-item" style="margin-bottom: 10px;">Delete Selected Task</button>

                <ul class="task-list">
                    <%for(let task=0; task<result.length; task++) { %>
                        <li class="task-item">
                            <div class="task-title">
                                <%=result[task].title%>
                            </div>
                            <div class="task-description">
                                <%=result[task].description%>
                            </div>
                            <!-- checkbox for selecting to delete multi task -->
                            <input type="checkbox" name="selectedTask" id="" value="<%=result[task]._id%>">

                            <a class="delete-item" href="/delete/<%=result[task]._id%>">Delete</a>
                            <a class="update-item" href="/update/<%=result[task]._id%>">update</a>
                        </li>
                        <%}%>
                </ul>

            </form>
        </div>
</body>

</html>