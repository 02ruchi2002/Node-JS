<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <%- include('navbar')%>
    <div class="container">
        <h1>Update Todo</h1>
       <form class="todo-form" action="/update/<%=result._id%>" method="post">
        <input class="input" type="text" name="title" placeholder="Enter Title" value="<%= result.title%>">
        <br>
        <br>
        <textarea class="input" name="description" placeholder="Enter Description"><%= result.description%></textarea>
        <br>
        <br>
        <button class="btn">Update Task</button>
       </form>
    </div>
</body>
</html>